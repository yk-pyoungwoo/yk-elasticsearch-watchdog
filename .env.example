# Slack
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Elasticsearch
ES_URL=http://localhost:19200
ES_USER=
ES_PASS=
INSECURE_TLS=1

# --- 경로: 저장소 루트 기준 상대 경로 (watchdog/ 레이아웃 권장) ---
# 최초: cp .env.example .env && ./scripts/init-watchdog-dirs.sh

# run-weekly-call_sessions
CS_CALL_REPORT_BASE_DIR=watchdog/call_sessions/workspace
CS_EXTRACT_SCRIPT=extract-call_sessions-footprints-weekly.py
CS_OUTPUT_ROOT=watchdog/call_sessions/exports
CS_LOG_DIR=watchdog/call_sessions/logs
CS_PYTHON_BIN=python3
CS_RUN_SCRIPT=run-weekly-call_sessions.py

# run-weekly-kakao_sessions
KS_CALL_REPORT_BASE_DIR=watchdog/kakao_sessions/workspace
KS_EXTRACT_SCRIPT=extract-kakao_sessions-footprints-weekly.py
KS_OUTPUT_ROOT=watchdog/kakao_sessions/exports
KS_LOG_DIR=watchdog/kakao_sessions/logs
KS_PYTHON_BIN=python3
KS_RUN_SCRIPT=run-weekly-kakao_sessions.py

# run-weekly-viral_marketing_logs
VM_VIRAL_BASE_DIR=watchdog/viral/workspace
VM_EXTRACT_SCRIPT=extract-viral_marketing.py
VM_OUTPUT_ROOT=watchdog/viral/exports
VM_LOG_DIR=watchdog/viral/logs
VM_CHECKPOINT_DIR=watchdog/viral/checkpoint
VM_BATCH_SIZE=2000
VM_SLEEP_SEC=0
VM_PYTHON_BIN=python3
VM_RUN_SCRIPT=run-weekly-viral_marketing_logs.py
